# segl configuration, installed as /opt/segl/etc/segl.toml and read by
# `segl --config /opt/segl/etc/segl.toml` (docs/DEPLOY.md). Every key is
# listed with its default. A key segl does not know stops it from starting.

# The address segl listens on, host:port. Keep it on loopback and let nginx
# face the network. Keep the upstream in /etc/nginx/conf.d/segl.conf in step.
# An IPv6 host goes in brackets: "[::1]:8888".
bind = "127.0.0.1:8888"

# The addresses, or networks such as "10.0.0.0/8", whose X-Forwarded-For and
# X-Forwarded-Proto headers segl believes. Keep it to the nginx host.
trusted_proxies = ["127.0.0.1", "::1"]

# Empty: anyone who can open a slot can edit it. Set a value and only browsers
# that hold it can edit; everyone else still watches. When you set one, make
# this file mode 0640, owner root, group segl. A token is 1 to 256 printable
# ASCII characters with no space at either end: `openssl rand -base64 24`
# writes a good one. Give it to an editor as a link to a slot that ends in
# #e=<token> (docs/DEPLOY.md).
edit_token = ""

# Where segl keeps its data. The segl user needs to write the first two.
database = "/opt/segl/var/segl.sqlite"
assets_dir = "/opt/segl/var/assets"
# One word per line, 1 to 10 letters, for the names new visitors are given
# (Alpha1, Bravo2). Edit the file to change them, then restart segl. segl does
# not start when the file is missing or has no words.
display_names = "/opt/segl/etc/display-names.txt"

# The built web application: the folder that holds index.html. segl reads it
# when it starts. Without it, segl serves the API and no page.
web_dir = "/opt/segl/app/web/dist"

# Size limits in bytes: one uploaded image (10 MiB) and one scene (50 MiB).
# nginx's client_max_body_size in segl-proxy.conf must stay above both.
max_asset_bytes = 10485760
max_scene_bytes = 52428800

# History: revisions kept per slot, and the least time between two of them.
history_limit = 50
history_interval_seconds = 1

# How long after an edit the slot is written to the database.
head_flush_seconds = 0.2
