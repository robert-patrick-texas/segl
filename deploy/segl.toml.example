# segl configuration, installed as /opt/segl/etc/segl.toml and read by
# `segl --config /opt/segl/etc/segl.toml` (docs/DEPLOY.md). Every key is
# listed with its default. A key segl does not know stops it from starting.

# The address segl listens on, host:port. Keep it on loopback and let nginx
# face the network. Keep the upstream in /etc/nginx/conf.d/segl.conf in step.
# An IPv6 host goes in brackets: "[::1]:8888".
bind = "127.0.0.1:8888"

# The addresses, or networks such as "10.0.0.0/8", whose X-Forwarded-For and
# X-Forwarded-Proto headers segl believes. Keep it to the nginx host.
trusted_proxies = ["127.0.0.1", "::1"]

# The networks segl answers, in CIDR form, IPv4 and IPv6, such as
# ["10.0.0.0/8", "2001:db8::/32"]. Empty: segl answers every address. With one
# or more, a client outside them gets 403 for every page and every request.
# Loopback is always inside. segl sees a client's own address only through a
# proxy listed in trusted_proxies: through any other proxy, every client looks
# like the proxy (docs/DEPLOY.md). A firewall can do the same. This is the
# second check behind it.
internal_networks = []

# Access codes: words or phrases, each with at least 8 letters and digits,
# such as ["maple river 42", "Night shift 1836"]. Empty: anyone who can open a
# slot can edit it. With one or more, a browser edits once a person has
# entered one of them on the access page, and everyone else still watches.
# Case, spaces, and punctuation do not matter when a code is typed. This is
# not a login: it knows no user (docs/SECURITY.md). The package installs this
# file with mode 0640, owner root, group segl. Keep it so.
access_codes = []

# The secret that signs the pass a code buys. Needed with access_codes, and at
# least 32 characters: `openssl rand -base64 32` writes one. A new secret ends
# every pass.
access_secret = ""

# How many hours a pass lasts before the person enters a code again. 0 is no
# limit.
access_pass_hours = 12

# A pass issued before this time is refused, as in 2026-11-12T15:00:00Z. Set
# it and restart to end every pass issued so far, while the codes still work.
# `date -u +%Y-%m-%dT%H:%M:%SZ` writes the time now. "" is no such time.
access_passes_after = ""

# Where segl keeps its data. The segl user needs to write the first two.
database = "/opt/segl/var/segl.sqlite"
assets_dir = "/opt/segl/var/assets"
# One word per line, 1 to 10 letters, for the names new visitors are given
# (Alpha1, Bravo2). Edit the file to change them, then restart segl. segl does
# not start when the file is missing or has no words.
display_names = "/opt/segl/etc/display-names.txt"

# The built web application: the folder that holds index.html. segl reads it
# when it starts. Without it, segl serves the API and no page.
web_dir = "/opt/segl/app/web/dist"

# Size limits in bytes: one uploaded image (10 MiB) and one scene (50 MiB).
# nginx's client_max_body_size in segl-proxy.conf must stay above both.
max_asset_bytes = 10485760
max_scene_bytes = 52428800

# History: revisions kept per slot, and the least time between two of them.
history_limit = 50
history_interval_seconds = 1

# How long after an edit the slot is written to the database.
head_flush_seconds = 0.2

# Where `segl update` asks for releases: the GitHub API of segl's repository.
# A GitHub Enterprise server, or a mirror that answers the same paths, works
# too (docs/DEPLOY.md, updates). It must be an https:// address.
update_url = "https://api.github.com/repos/robert-patrick-texas/segl"

# The proxy `segl update` reaches GitHub through, such as
# "http://proxy.example.com:3128". The update timer uses it too. "" is none:
# then `--proxy` on the command line, or https_proxy from the environment,
# which the timer does not have.
update_proxy = ""
