{
	"name": "segl-web",
	"private": true,
	"description": "segl web application: the Excalidraw canvas and the segl bar, served by the segl Python process.",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=11.20.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"prettier": "3.10.1",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
