# Track draft1/, draft2/, docs/, and journal/. They belong in the public repository.
# Ignore secrets and build output only.

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
node_modules/
web/dist/
# The list of bundled packages the web build writes (web/scripts/bundled-packages.ts).
web/.bundled-packages.json
*.sqlite
# Development data from the default config (docs/DEPLOY.md).
var/
# Playwright output.
test-results/
playwright-report/
segl.toml
*.local.toml
.DS_Store
# Documentation site built by scripts/build_docs.py.
_site/
